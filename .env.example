# ==========================================
# AGROCONNECT — Environment Variables (Phase 3 Foundation)
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication (Phase 4 Integration)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_key
# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Endpoint Secret)
CLERK_WEBHOOK_SECRET=whsec_placeholder_secret

# Supabase PostgreSQL & API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_key
# Server-only Service Role Key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Geographic & Map Provider (MapLibre + OpenFreeMap / Configurable Geocoding)
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
NEXT_PUBLIC_MAP_STYLE=liberty
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_TOKEN=
NEXT_PUBLIC_GEOCODING_URL=
NEXT_PUBLIC_GEOCODING_KEY=

# Cloudflare (Future video & asset storage metadata)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_R2_BUCKET=
