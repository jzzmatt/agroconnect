# ==========================================
# AGROCONNECT — Environment Variables (Phase 3 Foundation)
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication (Phase 4 Integration)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_key
# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Endpoint Secret)
CLERK_WEBHOOK_SECRET=whsec_placeholder_secret

# Supabase PostgreSQL & API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_key
# Server-only Service Role Key (Never expose to browser)
# Required to publish products/images when Clerk JWT is not a Supabase JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Authorization
# Lets a signed-in user activate a PAID plan for themselves without a confirmed
# payment, so plans can be selected freely while building and demonstrating the
# product. While true, any authenticated user can grant themselves any tier.
#
# Set this to false to close it — that is the gate to throw once payment
# confirmation is in place (phase 11). Only the exact string "false" disables it,
# and the feature is also on when the variable is absent entirely.
ALLOW_SELF_SERVICE_PLAN_ACTIVATION=true

# Geographic & Map Provider (MapQuest Platform)
NEXT_PUBLIC_MAP_PROVIDER=mapquest
NEXT_PUBLIC_MAPQUEST_API_KEY=your_mapquest_api_key_here
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_DARK_STYLE_URL=

# ImageKit (product images, product short videos, profile/application media)
# From the ImageKit dashboard → Developer options.
# IMAGEKIT_PRIVATE_KEY is server-only and must never be sent to the browser.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Bunny Stream (legacy product-video rows only — AgriAcademy uses YouTube Unlisted)
# Do NOT use Bunny for new AgriAcademy training video.
# Use the Stream *library* API key from Stream → your library → API.
# Do NOT use the Bunny account/global API key.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
# Pull-zone hostname without https://  e.g. vz-xxxxxxxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# Required to accept /api/webhooks/bunny deliveries. Set this to the library's
# webhook signing secret (Bunny dashboard -> Stream -> your library ->
# Webhooks). There is no unsigned fallback: an unset or invalid secret makes
# every webhook request return 401.
BUNNY_STREAM_WEBHOOK_SECRET=
